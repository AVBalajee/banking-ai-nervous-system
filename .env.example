# Copy this file to .env and fill in real values to move from mock mode to live mode.

# --- AI / LLM ---
# Set LLM_PROVIDER to "openai" to use a real model, or leave as "mock" for offline demo mode.
LLM_PROVIDER=mock
OPENAI_API_KEY=

# --- External data sources (optional, for live ingestion instead of simulated feed) ---
NEWS_API_KEY=
RBI_DATA_API_KEY=
TWITTER_BEARER_TOKEN=

# --- Database credentials (defaults match docker-compose.yml) ---
POSTGRES_DB=nervous_system
POSTGRES_USER=bank_admin
POSTGRES_PASSWORD=bank_admin_pw

NEO4J_USER=neo4j
NEO4J_PASSWORD=nervous_system_pw
